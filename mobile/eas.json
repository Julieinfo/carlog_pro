{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_NAME": "CarLog Pro",
        "EXPO_PUBLIC_API_URL": "https://carlog-pro.onrender.com/api"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_NAME": "CarLog Pro",
        "EXPO_PUBLIC_API_URL": "https://carlog-pro.onrender.com/api"
      }
    }
  }
}
