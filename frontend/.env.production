# Chargé uniquement par `npm run dev` (mode development de Vite).
# En local, le frontend doit parler au backend local : l'API Render est en NODE_ENV=production
# et n'autorise que l'origine Vercel, donc elle refuse les requêtes depuis localhost (CORS).
# Le build de production continue d'utiliser VITE_API_URL du fichier `.env` (API Render).
VITE_API_URL=https://carlog-pro.onrender.com/api