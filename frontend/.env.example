# Modèle des variables d'environnement du frontend CarLog Pro (Vite).
# Copier en `.env` si besoin ; le fichier `.env` est ignoré par Git.
#
# RÈGLE : aucun secret ici. Tout ce qui est préfixé VITE_ est injecté dans le bundle JavaScript public.
# MONGO_URI et JWT_SECRET n'ont rien à faire côté frontend : ils vivent uniquement dans backend/.env
# et dans les variables Render. (Vite ignore les variables sans préfixe VITE_, mais ne pas compter dessus.)

# Base de l'API. Vide en local et sur Replit : le frontend appelle `/api`, relayé par Vite vers Express.
# Sur Vercel : URL publique de l'API Render suivie de /api, ex. https://carlog-pro-api.onrender.com/api
VITE_API_URL=

# Port du serveur de développement Vite (5173 par défaut).
VITE_PORT=
