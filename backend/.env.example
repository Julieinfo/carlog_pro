# Modèle des variables d'environnement du backend CarLog Pro.
# Copier en `.env` (développement) et `.env.test` (tests Jest) ; ces deux fichiers sont ignorés par Git.
# En production (Render), ces variables sont saisies dans le dashboard, jamais dans un fichier.
# NE JAMAIS mettre de valeur réelle dans ce fichier : il est suivi par Git.

# --- Obligatoires ---
# Connexion MongoDB Atlas de développement (URI SRV ou URI longue en dépannage DNS).
MONGO_URI=
# Secret de signature des JWT (HS256). Générer une valeur longue et aléatoire, par exemple :
#   openssl rand -base64 48
JWT_SECRET=

# --- Tests (fichier .env.test uniquement) ---
# Base de test DÉDIÉE, physiquement différente de la base de dev et de prod.
# Les suites d'intégration (inscription) utilisent des transactions : le cluster doit être un replica set (Atlas l'est toujours).
MONGO_URI_TEST=

# --- Production (Render) ---
# Origine exacte du frontend autorisée par CORS, sans barre oblique finale. Ex. https://carlog-pro.vercel.app
FRONTEND_URL=
# Fixé à `production` sur Render : active trust proxy, messages d'erreur génériques et exclusion des devDependencies.
NODE_ENV=

# --- Facultatives ---
# Port HTTP local (5000 par défaut). Render injecte sa propre valeur : ne pas la définir là-bas.
PORT=
